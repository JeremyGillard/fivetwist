{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    // Code passed to `page.evaluate` runs in the browser.
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
